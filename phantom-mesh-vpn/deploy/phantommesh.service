[Unit]
Description=PhantomMesh VPN - Quantum-Resistant Mesh VPN
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/phantommesh up
ExecStop=/usr/local/bin/phantommesh down
ExecStopPost=/sbin/iptables -F OUTPUT
ExecStopPost=/sbin/iptables -P OUTPUT ACCEPT
Restart=always
RestartSec=5

# Security hardening
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE
NoNewPrivileges=no
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/etc/resolv.conf /dev/net/tun /etc/phantommesh
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
